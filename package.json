    "react-native": "0.74.0",
    "react-native-face-detector": "^1.0.0",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-gesture-handler": "^2.12.0",
    "react-native-safe-area-context": "^4.7.0",
